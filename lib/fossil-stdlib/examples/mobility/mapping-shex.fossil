type PassengerComfortData = csv!(@mobility-data/passenger_comfort.csv)
type PotholeTelemetryData = csv!(@mobility-data/pothole_telemetry.csv)
type RouteEfficiencyData = csv!(@mobility-data/route_efficiency.csv)

type {
    Vehicle(identifier: string),
    Route(identifier: int),
    Location(latitude: float, longitude: float),
    WeatherObservation(id: string),
    PassengerImpact(id: string),
    PotholeEvent(id: string),
    RouteEfficiency(id: string),
} = shex!(@mobility-vocab/urban-mobility.shex)

let passenger_data =
    PassengerComfortData.load()
        |> each row -> PassengerComfortData {
            ..row,
            unit_identifier = row.unit_identifier |> String.extract("(\d+)"),
        }

let pothole_data =
    PotholeTelemetryData.load()
        |> each row -> PotholeTelemetryData {
            ..row,
            bus_code = row.bus_code |> String.extract("(\d+)"),
        }

let route_data =
    RouteEfficiencyData.load()
        |> each row -> RouteEfficiencyData {
            ..row,
            fleet_unit = row.fleet_unit |> String.extract("(\d+)"),
        }

let weather_data = csv!(@mobility-data/weather_observations.csv)

passenger_data
|> join pothole_data on (
    unit_identifier,
    recorded_at,
    geo_location_lat,
    geo_location_lon
) = (
    bus_code,
    timestamp,
    pothole_latitude,
    pothole_longitude
)
|> join route_data on (
    unit_identifier,
    recorded_at,
    geo_location_lat,
    geo_location_lon
) = (
    fleet_unit,
    event_time,
    coord_lat,
    coord_lng
)
|> join weather_data on (
    recorded_at,
    geo_location_lat,
    geo_location_lon
) = (
    observation_time,
    geo_point_latitude,
    geo_point_longitude
)
|> each row -> WeatherObservation(row.unit_identifier) {
    dateTime = row.recorded_at,
    temperature = row.air_temperature_c,
    humidityPercentage = row.humidity_pct,
    precipitation = row.precipitation_mm,
    windSpeed = row.wind_speed_kmh,
    visibility = row.visibility_km,
    weatherCondition = row.weather_condition,
    roadCondition = row.road_condition_estimated,
    hasLocation = ref Location(row.geo_location_lat, row.geo_location_lon),
}
+> each row -> PassengerImpact(row.unit_identifier) {
    dateTime = row.recorded_at,
    comfortScore = row.comfort_score,
    complaintCount = row.complaint_count,
    ridershipImpact = row.ridership_impact,
    passengerSatisfaction = row.passenger_satisfaction,
    reportedBy = ref Vehicle(row.unit_identifier),
    hasLocation = ref Location(row.geo_location_lat, row.geo_location_lon),
    relatedTo = ref Route(row.service_line),
}
+> each row -> PotholeEvent("PotholeDetection_${row.unit_identifier}_${row.recorded_at}") {
    dateTime = row.recorded_at,
    severity = row.severity,
    confidence = row.confidence,
    sizeInMilimiters = row.size_mm,
    roadSurfaceCondition = row.road_surface_condition,
    detectedBy = ref Vehicle(row.unit_identifier),
    hasLocation = ref Location(row.geo_location_lat, row.geo_location_lon),
    occursAt = ref WeatherObservation(row.unit_identifier),
    relatedTo = ref Route(row.service_line),
}
+> each row -> RouteEfficiency(row.unit_identifier) {
    dateTime = row.recorded_at,
    altRouteFlag = row.alt_route_flag,
    delayMinutes = row.delay_minutes,
    fuelExtraPercentage = row.fuel_extra_pct,
    detourDistanceInKilometers = row.detour_km,
    performedBy = ref Vehicle(row.unit_identifier),
    hasLocation = ref Location(row.geo_location_lat, row.geo_location_lon),
    relatedTo = ref Route(row.service_line),
}
+> each row -> Location(row.geo_location_lat, row.geo_location_lon) {
    latitude = row.geo_location_lat,
    longitude = row.geo_location_lon
}
+> each row -> Vehicle(row.unit_identifier) {
    identifier = row.unit_identifier
}
+> each row -> Route(row.service_line) {
    identifier = row.service_line
}
|> Rdf.serialize(@mobility-data/mobility.nq)
