type PassengerComfortData = csv!(@mobility-data/passenger_comfort.csv)
type PotholeTelemetryData = csv!(@mobility-data/pothole_telemetry.csv)
type RouteEfficiencyData = csv!(@mobility-data/route_efficiency.csv)
type WeatherObservationData = csv!(@mobility-data/weather_observations.csv)

type Vehicle(identifier: string) = shex!(@mobility-vocab/urban-mobility.shex, shape: "Vehicle")
type Route(identifier: string) = shex!(@mobility-vocab/urban-mobility.shex, shape: "Route")
type Location(latitude: string, longitude: string) = shex!(@mobility-vocab/urban-mobility.shex, shape: "Location")
type WeatherObservation(id: string) = shex!(@mobility-vocab/urban-mobility.shex, shape: "WeatherObservation")
type PassengerImpact(id: string) = shex!(@mobility-vocab/urban-mobility.shex, shape: "PassengerImpact")
type PotholeEvent(id: string) = shex!(@mobility-vocab/urban-mobility.shex, shape: "PotholeEvent")
type RouteEfficiency(id: string) = shex!(@mobility-vocab/urban-mobility.shex, shape: "RouteEfficiency")

let passenger_efficiency =
    PassengerComfortData.load()
        |> each row -> PassengerComfortData {
            ..row,
            unit_identifier = row.unit_identifier |> String.extract("(\d+)"),
        }

let pothole_telemetry =
    PotholeTelemetryData.load()
        |> each row -> PotholeTelemetryData {
            ..row,
            bus_code = row.bus_code |> String.extract("(\d+)"),
        }

let route_efficiency =
    RouteEfficiencyData.load()
        |> each row -> RouteEfficiencyData {
            ..row,
            fleet_unit = row.fleet_unit |> String.extract("(\d+)"),
        }

passenger_efficiency
|> join pothole_telemetry on (unit_identifier, recorded_at) = (bus_code, timestamp)
|> join route_efficiency  on (unit_identifier, recorded_at) = (fleet_unit, event_time)
|> join WeatherObservationData.load() on (recorded_at) = (observation_time)
|> each row -> WeatherObservation(row.unit_identifier) {
    dateTime = row.recorded_at,
    temperature = row.air_temperature_c,
    humidityPercentage = row.humidity_pct,
    precipitation = row.precipitation_mm,
    windSpeed = row.wind_speed_kmh,
    visibility = row.visibility_km,
    weatherCondition = row.weather_condition,
    roadCondition = row.road_condition_estimated,
    hasLocation = Location(row.geo_point_latitude, row.geo_point_longitude),
}
+> each row -> PassengerImpact(row.unit_identifier) {
    dateTime = row.recorded_at,
    comfortScore = row.comfort_score,
    complaintCount = row.complaint_count,
    ridershipImpact = row.ridership_impact,
    passengerSatisfaction = row.passenger_satisfaction,
    reportedBy = Vehicle(row.unit_identifier),
    hasLocation = Location(row.geo_location_lat, row.geo_location_lon),
    relatedTo = Route(row.service_line),
}
+> each row -> PotholeEvent(row.unit_identifier) {
    dateTime = row.recorded_at,
    severity = row.severity,
    confidence = row.confidence,
    sizeInMilimiters = row.size_mm,
    roadSurfaceCondition = row.road_surface_condition,
    detectedBy = Vehicle(row.unit_identifier),
    hasLocation = Location(row.pothole_latitude, row.pothole_longitude),
    occursAt = WeatherObservation(row.unit_identifier),
    relatedTo = Route(row.service_line),
}
+> each row -> RouteEfficiency(row.unit_identifier) {
    dateTime = row.recorded_at,
    altRouteFlag = row.fuel_extra_pct,
    delayMinutes = row.detour_km,
    fuelExtraPercentage = row.fuel_extra_pct,
    detourDistanceInKilometers = row.detour_km,
    performedBy = Vehicle(row.unit_identifier),
    hasLocation = Location(row.coord_lat, row.coord_lng),
    relatedTo = Route(row.service_line),
}
|> Rdf.serialize(@mobility-data/new.nq)
