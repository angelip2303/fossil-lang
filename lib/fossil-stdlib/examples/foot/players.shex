PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX schema: <https://schema.org/>
BASE <http://example.org/FootballExample#>

<SportsTeam> {
    rdfs:label          xsd:string            ;
    schema:identifier   xsd:int               ;
    schema:name         xsd:string            ;
    schema:memberOf     @<SportsOrganization> ;
    schema:athlete      @<Player>
}

<SportsOrganization> {
    rdfs:label          xsd:string ;
    schema:identifier   xsd:string
}

<Player> {
    rdfs:label              xsd:string             ;
    schema:identifier       xsd:int                ;
    schema:givenName        xsd:string             ;
    schema:familyName       xsd:string             ;
    schema:height           xsd:int                ;
    schema:birthDate        xsd:date               ;
    schema:image            xsd:anyURI             ;
    schema:url              xsd:anyURI             ;
    <goodLeg>               xsd:string             ;
    schema:birthPlace       @<City>                ;
    schema:nationality      @<Country>             ;
    schema:hasOccupation    @<Role>                ;
    schema:netWorth         @<MonetaryAmount>      ;
    schema:contactPoint     @<EmploymentAgency>
}

<City> {
    rdfs:label              xsd:string ;
    schema:name             xsd:string ;
    schema:containedInPlace @<Country>
}

<Country> {
    rdfs:label  xsd:string ;
    schema:name xsd:string
}

<Role> {
    rdfs:label      xsd:string      ;
    schema:endDate  xsd:date        ;
    schema:roleName xsd:string
}

<MonetaryAmount> {
    rdfs:label      xsd:string ;
    schema:value    xsd:int    ;
    schema:maxValue xsd:int    ;
    schema:currency xsd:string
}

<EmploymentAgency> {
    rdfs:label  xsd:string ;
    schema:name xsd:string
}
