let input = csv!("tests/RMLTC0000-CSV/student.csv")

#[rdf(subject = "http://example.com/{subject}")]
type Output(subject: string) do
    #[rdf(uri = "http://xmlns.com/foaf/0.1/name")]
    Name: string
end

input
|> each row -> Output(row.Name) { Name = row.Name }
|> Rdf.serialize("tests/RMLTC0000-CSV/actual.nq")
